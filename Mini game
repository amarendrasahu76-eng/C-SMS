#include <iostream>
#include <vector>

using namespace std;

// Function to draw the dynamic Tic Tac Toe board
void drawBoard(const vector<char>& board) {
    cout << "\n";
    cout << "     |     |     \n";
    cout << "  " << board[0] << "  |  " << board[1] << "  |  " << board[2] << "  \n";
    cout << "_____|_____|_____\n";
    cout << "     |     |     \n";
    cout << "  " << board[3] << "  |  " << board[4] << "  |  " << board[5] << "  \n";
    cout << "_____|_____|_____\n";
    cout << "     |     |     \n";
    cout << "  " << board[6] << "  |  " << board[7] << "  |  " << board[8] << "  \n";
    cout << "     |     |     \n\n";
}

// Function to check if a player has won
bool checkWin(const vector<char>& board, char player) {
    // Winning combinations (Rows, Columns, Diagonals)
    const int winPatterns[8][3] = {
        {0, 1, 2}, {3, 4, 5}, {6, 7, 8}, // Rows
        {0, 3, 6}, {1, 4, 7}, {2, 5, 8}, // Columns
        {0, 4, 8}, {2, 4, 6}             // Diagonals
    };

    for (int i = 0; i < 8; i++) {
        if (board[winPatterns[i][0]] == player &&
            board[winPatterns[i][1]] == player &&
            board[winPatterns[i][2]] == player) {
            return true;
        }
    }
    return false;
}

// Function to check if the board is full (Draw condition)
bool checkDraw(const vector<char>& board) {
    for (int i = 0; i < 9; i++) {
        if (board[i] != 'X' && board[i] != 'O') {
            return false;
        }
    }
    return true;
}

// Main Game Loop Function
void playGame() {
    vector<char> board = {'1', '2', '3', '4', '5', '6', '7', '8', '9'};
    char currentPlayer = 'X';
    bool gameWon = false;
    bool gameDraw = false;

    while (!gameWon && !gameDraw) {
        drawBoard(board);

        int choice;
        cout << "Player " << currentPlayer << ", enter a position (1-9): ";
        cin >> choice;

        // Input validation
        if (cin.fail() || choice < 1 || choice > 9) {
            cin.clear();
            cin.ignore(10000, '\n');
            cout << "Invalid position! Please enter a number between 1 and 9.\n";
            continue;
        }

        int index = choice - 1;

        // Check if position is already taken
        if (board[index] == 'X' || board[index] == 'O') {
            cout << "Position already taken! Try another spot.\n";
            continue;
        }

        // Apply move
        board[index] = currentPlayer;

        // Check for Win or Draw
        if (checkWin(board, currentPlayer)) {
            gameWon = true;
            drawBoard(board);
            cout << "Congratulations! Player " << currentPlayer << " Wins!\n";
        } else if (checkDraw(board)) {
            gameDraw = true;
            drawBoard(board);
            cout << "It's a Draw!\n";
        } else {
            // Switch turns
            currentPlayer = (currentPlayer == 'X') ? 'O' : 'X';
        }
    }
}

int main() {
    char replayChoice;

    do {
        cout << "=========================================\n";
        cout << "          TIC TAC TOE MINI GAME          \n";
        cout << "=========================================\n";

        playGame();

        cout << "\nDo you want to play again? (Y/N): ";
        cin >> replayChoice;

    } while (replayChoice == 'Y' || replayChoice == 'y');

    cout << "\nThanks for playing! Goodbye.\n";
    return 0;
}

